APP_NAME=Secure Web Activity Monitor
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
# Local default: sqlite:///./monitor.db. For Compose, set DATABASE_URL in this file
# to use PostgreSQL; otherwise Compose persists SQLite at /data/monitor.db.
ACCESS_TOKEN_MINUTES=60
ALLOW_REGISTRATION=true
RETENTION_DAYS=90
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MINUTES=10
ACTIVITY_BURST_THRESHOLD=120
ACTIVITY_BURST_WINDOW_MINUTES=5
SENSITIVE_PATHS=/admin,/wp-admin,/login,/account/recovery
ANOMALY_MODEL_ENABLED=true
MAX_EVENT_BATCH=100
MAX_REQUEST_BYTES=1048576
